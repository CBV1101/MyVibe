{
  "manifest_version": 3,
  "name": "MyVibe",
  "version": "0.8.0",
  "description": "Privacy-first writing tone coach and vibe score prototype",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.threads.net/*",
        "https://bsky.app/*"
      ],
      "js": [
        "tone.js",
        "review.js",
        "evidence.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "insights.html",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "https://public.api.bsky.app/*"
  ]
}
